---
const products = [
  { name: 'RECTANGULAR CONNECTOR', image: '/images/products/rectangular-connector.png', href: '/products/electrical-connector/rectangular-connector' },
  { name: 'CIRCULAR CONNECTOR', image: '/images/products/circular-connector.png', href: '/products/electrical-connector/circular-connector' },
  { name: 'RF CONNECTOR', image: '/images/products/rf-connector.png', href: '/products/electrical-connector/rf-connector' },
  { name: 'CABLE ASSEMBLY', image: '/images/products/cable-assembly.jpg', href: '/products/cable-assembly' },
  { name: 'BLDC TORQUE MOTOR', image: '/images/products/bldc-torque-motor.png', href: '/products/bldc-torque-motor' },
  { name: 'RESOLVER TRANSMITTER', image: '/images/products/bldc-torque-motor.png', href: '/products/resolver-transmitter' },
  { name: 'ROTARY ENCODER', image: '/images/products/bldc-torque-motor.png', href: '/products/rotary-encoder' },
];
---

<section class="py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center text-primary mb-10">Product Display</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {products.map((p) => (
        <a href={p.href} class="group bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden">
          <div class="aspect-square p-4 flex items-center justify-center bg-white">
            <img src={p.image} alt={`${p.name} - Shenzhen Qiyang Electronics`} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" />
          </div>
          <div class="p-3 text-center border-t">
            <span class="text-sm font-semibold text-gray-700 group-hover:text-primary transition-colors">{p.name}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
