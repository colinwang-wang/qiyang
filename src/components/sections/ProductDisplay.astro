---
import { url } from '../../utils/url';

const products = [
  { name: 'RECTANGULAR CONNECTOR', image: url('/images/products/rectangular-connector.png'), href: url('/products/electrical-connector/rectangular-connector') },
  { name: 'CIRCULAR CONNECTOR', image: url('/images/products/circular-connector.png'), href: url('/products/electrical-connector/circular-connector') },
  { name: 'RF CONNECTOR', image: url('/images/products/rf-connector.png'), href: url('/products/electrical-connector/rf-connector') },
  { name: 'CABLE ASSEMBLY', image: url('/images/products/cable-assembly.png'), href: url('/products/cable-assembly') },
  { name: 'BLDC TORQUE MOTOR', image: url('/images/products/bldc-torque-motor.jpg'), href: url('/products/bldc-torque-motor') },
  { name: 'RESOLVER TRANSMITTER', image: url('/images/products/resolver-transmitter.png'), href: url('/products/resolver-transmitter') },
  { name: 'ROTARY ENCODER', image: url('/images/products/rotary-encoder.png'), href: url('/products/rotary-encoder') },
  { name: 'INTERNATIONAL BRANDS', image: url('/images/products/board-to-board-connector.png'), href: url('/products/international-brands') },
];
---

<section class="py-10 md:py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-center text-primary mb-8 md:mb-10">PRODUCTS</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-6">
      {products.map((p) => (
        <a href={p.href} class="group bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden">
          <div class="aspect-square p-6 flex items-center justify-center bg-white">
            <img src={p.image} alt={`${p.name} - Shenzhen Qiyang Electronics`} class={`object-contain group-hover:scale-105 transition-transform ${p.name === 'RECTANGULAR CONNECTOR' ? 'max-h-[55%] max-w-[55%]' : 'max-h-[70%] max-w-[70%]'}`} />
          </div>
          <div class="p-3 text-center border-t">
            <span class="text-sm font-semibold text-gray-700 group-hover:text-primary transition-colors">{p.name}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
