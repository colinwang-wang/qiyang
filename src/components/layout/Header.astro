---
import { url } from '../../utils/url';

const navItems = [
  { label: 'HOME', href: url('/') },
  { label: 'PRODUCTS', href: url('/products') },
  { label: 'APPLICATIONS', href: url('/applications') },
  { label: 'NEWS', href: url('/news') },
  { label: 'ABOUT US', href: url('/about') },
  { label: 'CONTACT US', href: url('/contact') },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <!-- Top bar -->
  <div class="bg-primary text-white text-xs sm:text-sm py-1">
    <div class="max-w-7xl mx-auto px-4 flex justify-end gap-4 sm:gap-6">
      <span>Email: sales@sz-qy.com.cn</span>
      <span class="hidden sm:inline">Tel: +86 755-XXXX-XXXX</span>
    </div>
  </div>

  <!-- Main nav -->
  <nav class="max-w-7xl mx-auto px-4 flex items-center justify-between h-16">
    <a href={url('/')} class="flex items-center gap-3">
      <img src={url('/images/logo.png')} alt="Qiyang Logo" class="h-10" />
      <span class="text-sm font-semibold text-primary hidden lg:block leading-tight">
        Shenzhen Qiyang<br />Electronics Co., Ltd.
      </span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-1">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'px-3 py-2 text-sm font-medium rounded transition-colors',
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'text-primary bg-blue-50'
                : 'text-gray-700 hover:text-primary hover:bg-blue-50',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-gray-700"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile nav -->
  <div id="mobile-menu" class="hidden md:hidden border-t">
    <ul class="px-4 py-2 space-y-1">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'block px-3 py-2 text-sm font-medium rounded',
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'text-primary bg-blue-50'
                : 'text-gray-700 hover:text-primary',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
