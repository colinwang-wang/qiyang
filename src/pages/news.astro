---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout title="News - Shenzhen Qiyang Electronics" description="Latest news and updates from Shenzhen Qiyang Electronics Co., Ltd.">
  <Header />
  <main class="flex-1">
    <div class="bg-primary text-white py-12">
      <div class="max-w-7xl mx-auto px-4">
        <h1 class="text-3xl font-bold">NEWS</h1>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="text-center py-16">
        <p class="text-gray-500 text-lg">News and updates coming soon.</p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
