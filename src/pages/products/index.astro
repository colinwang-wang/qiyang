---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { url } from '../../utils/url';

const categories = [
  { name: 'ELECTRICAL CONNECTOR', slug: 'electrical-connector', image: url('/images/products/electrical-connector.png') },
  { name: 'CABLE ASSEMBLY', slug: 'cable-assembly', image: url('/images/products/cable-assembly.png') },
  { name: 'BLDC TORQUE MOTOR', slug: 'bldc-torque-motor', image: url('/images/products/bldc-torque-motor.jpg') },
  { name: 'RESOLVER TRANSMITTER', slug: 'resolver-transmitter', image: url('/images/products/resolver-transmitter.png') },
  { name: 'ROTARY ENCODER', slug: 'rotary-encoder', image: url('/images/products/rotary-encoder.png') },
  { name: 'INTERNATIONAL BRANDS', slug: 'international-brands', image: url('/images/products/international-brands.png') },
];
---

<BaseLayout title="Products - Shenzhen Qiyang Electronics" description="Browse our product categories: Electrical Connectors, Cable Assembly, BLDC Torque Motors, Resolver Transmitters, Rotary Encoders and International Brands.">
  <Header />
  <main class="flex-1">
    <div class="bg-primary text-white py-8 md:py-12">
      <div class="max-w-7xl mx-auto px-4">
        <h1 class="text-2xl md:text-3xl font-bold">PRODUCTS</h1>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        {categories.map((cat) => (
          <a href={url(`/products/${cat.slug}`)} class="group bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden border">
            <div class="aspect-square p-6 flex items-center justify-center">
              <img src={cat.image} alt={`${cat.name} - Shenzhen Qiyang Electronics`} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" />
            </div>
            <div class="p-4 text-center border-t bg-gray-50">
              <span class="text-sm font-bold text-gray-800 group-hover:text-primary transition-colors">{cat.name}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
