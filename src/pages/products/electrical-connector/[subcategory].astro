---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const productsDir = path.join(process.cwd(), 'src/content/products');
  const slugs = ['rectangular-connector', 'circular-connector', 'rf-connector'];
  
  return slugs.map((slug) => {
    const data = JSON.parse(fs.readFileSync(path.join(productsDir, `${slug}.json`), 'utf-8'));
    return { params: { subcategory: slug }, props: { data } };
  });
}

const { subcategory } = Astro.params;
const { data } = Astro.props;
---

<BaseLayout title={`${data.name} - Shenzhen Qiyang Electronics`}>
  <Header />
  <main class="flex-1">
    <div class="bg-primary text-white py-12">
      <div class="max-w-7xl mx-auto px-4">
        <nav class="text-sm text-blue-200 mb-2">
          <a href="/products" class="hover:text-white">Products</a> &gt;
          <a href="/products/electrical-connector" class="hover:text-white">Electrical Connector</a> &gt;
          {data.name}
        </nav>
        <h1 class="text-3xl font-bold">{data.name.toUpperCase()}</h1>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {data.series.map((series: any) => (
          <a href={`/products/electrical-connector/${subcategory}/${series.slug}`} class="group bg-white rounded-lg border hover:shadow-md transition-shadow overflow-hidden">
            <div class="aspect-square p-4 flex items-center justify-center bg-gray-50">
              <img src={`/images/products/${series.image}`} alt={`${series.name} - ${data.name} - Shenzhen Qiyang Electronics`} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" />
            </div>
            <div class="p-3 text-center border-t">
              <span class="text-sm font-semibold text-gray-700 group-hover:text-primary transition-colors">{series.name}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
