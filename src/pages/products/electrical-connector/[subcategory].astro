---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import { url } from '../../../utils/url';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const productsDir = path.join(process.cwd(), 'src/content/products');
  const slugs = ['rectangular-connector', 'circular-connector', 'rf-connector'];
  
  return slugs.map((slug) => {
    const data = JSON.parse(fs.readFileSync(path.join(productsDir, `${slug}.json`), 'utf-8'));
    return { params: { subcategory: slug }, props: { data } };
  });
}

const { subcategory } = Astro.params;
const { data } = Astro.props;
---

<BaseLayout title={`${data.name} - Shenzhen Qiyang Electronics`}>
  <Header />
  <main class="flex-1">
    <div class="bg-primary text-white py-8 md:py-12">
      <div class="max-w-7xl mx-auto px-4">
        <nav class="text-sm text-blue-200 mb-2">
          <a href={url('/products')} class="hover:text-white">Products</a> &gt;
          <a href={url('/products/electrical-connector')} class="hover:text-white">Electrical Connector</a> &gt;
          {data.name}
        </nav>
        <h1 class="text-2xl md:text-3xl font-bold">{data.name.toUpperCase()}</h1>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {data.series.map((series: any) => (
          <a href={url(`/products/electrical-connector/${subcategory}/${series.slug}`)} class="group bg-white rounded-lg border hover:shadow-md transition-shadow overflow-hidden">
            <div class="flex items-center justify-center gap-2 p-4 bg-gray-50 aspect-[4/3]">
              {series.images?.map((img: string) => (
                <img src={url(`/images/products/${img}`)} alt={`${series.name} - ${data.name} - Shenzhen Qiyang Electronics`} class:list={['object-contain group-hover:scale-105 transition-transform', series.images.length > 1 ? 'max-h-28 max-w-[45%]' : 'max-h-32 max-w-[70%]']} />
              ))}
            </div>
            <div class="p-3 text-center border-t">
              <span class="text-sm font-semibold text-gray-700 group-hover:text-primary transition-colors">{series.name}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
