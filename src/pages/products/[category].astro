---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { url } from '../../utils/url';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const productsDir = path.join(process.cwd(), 'src/content/products');
  const categories = ['bldc-torque-motor', 'resolver-transmitter', 'rotary-encoder', 'cable-assembly'];
  const paths: any[] = [];

  for (const slug of categories) {
    const filePath = path.join(productsDir, `${slug}.json`);
    if (fs.existsSync(filePath)) {
      const data = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
      paths.push({ params: { category: slug }, props: { data } });
    } else {
      paths.push({ params: { category: slug }, props: { data: { name: 'Cable Assembly', slug, series: [] } } });
    }
  }
  return paths;
}

const { category } = Astro.params;
const { data } = Astro.props;
const series = data.series?.[0];
---

<BaseLayout title={`${data.name} - Shenzhen Qiyang Electronics`}>
  <Header />
  <main class="flex-1">
    <div class="bg-primary text-white py-8 md:py-12">
      <div class="max-w-7xl mx-auto px-4">
        <nav class="text-sm text-blue-200 mb-2">
          <a href={url('/products')} class="hover:text-white">Products</a> &gt; {data.name}
        </nav>
        <h1 class="text-2xl md:text-3xl font-bold">{data.name.toUpperCase()}</h1>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 py-12">
      {series?.features ? (
        <div class="max-w-3xl mx-auto">
          <div class="bg-gray-50 rounded-lg p-8 mb-8 flex items-center justify-center">
            <img src={url(`/images/products/${series.image || 'bldc-torque-motor.png'}`)} alt={`${data.name} - Shenzhen Qiyang Electronics`} class="max-h-64 object-contain" />
          </div>
          <h2 class="text-2xl font-bold mb-6">Features</h2>
          <ul class="space-y-3">
            {series.features.map((f: string) => (
              <li class="flex items-start gap-3 text-gray-700">
                <span class="text-primary font-bold">✓</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a href={url('/contact')} class="inline-block mt-8 px-6 py-3 bg-accent text-white font-semibold rounded-lg hover:bg-amber-600 transition-colors">
            Request Quote
          </a>
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-gray-500 text-lg">Product details coming soon. Please contact us for more information.</p>
          <a href={url('/contact')} class="inline-block mt-6 px-6 py-3 bg-accent text-white font-semibold rounded-lg hover:bg-amber-600 transition-colors">
            Contact Us
          </a>
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
