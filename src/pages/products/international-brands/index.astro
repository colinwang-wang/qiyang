---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import { url } from '../../../utils/url';
import fs from 'node:fs';
import path from 'node:path';

const brandsDir = path.join(process.cwd(), 'public/images/brands');
const brandFiles = fs.readdirSync(brandsDir).filter(f => /\.(jpg|png|jpeg)$/i.test(f));

const connectorBrands = brandFiles.filter(f => f.startsWith('connector-'));
const passiveBrands = brandFiles.filter(f => f.startsWith('passive-'));
---

<BaseLayout title="International Brands - Shenzhen Qiyang Electronics" description="We distribute products from leading international brands including TE, MOLEX, AMPHENOL, MURATA, TDK and more.">
  <Header />
  <main class="flex-1">
    <div class="bg-primary text-white py-8 md:py-12">
      <div class="max-w-7xl mx-auto px-4">
        <nav class="text-sm text-blue-200 mb-2">
          <a href={url('/products')} class="hover:text-white">Products</a> &gt; International Brands
        </nav>
        <h1 class="text-2xl md:text-3xl font-bold">INTERNATIONAL BRANDS</h1>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
        {connectorBrands.map((file) => {
          const name = file.replace('connector-', '').replace(/\.(jpg|png)$/, '').toUpperCase();
          return (
            <div class="bg-white border rounded-lg p-4 flex items-center justify-center aspect-[3/2]">
              <img src={url(`/images/brands/${file}`)} alt={name} class="max-h-full max-w-full object-contain" />
            </div>
          );
        })}
        {passiveBrands.map((file) => {
          const name = file.replace('passive-', '').replace(/\.(jpg|png)$/, '').toUpperCase();
          return (
            <div class="bg-white border rounded-lg p-4 flex items-center justify-center aspect-[3/2]">
              <img src={url(`/images/brands/${file}`)} alt={name} class="max-h-full max-w-full object-contain" />
            </div>
          );
        })}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
