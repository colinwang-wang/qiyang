---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout title="Contact Us - Shenzhen Qiyang Electronics" description="Contact Shenzhen Qiyang Electronics Co., Ltd. for connector, motor and encoder inquiries. Located in Nanshan, Shenzhen, China.">
  <Header />
  <main class="flex-1">
    <div class="bg-primary text-white py-8 md:py-12">
      <div class="max-w-7xl mx-auto px-4">
        <h1 class="text-2xl md:text-3xl font-bold">CONTACT US</h1>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="max-w-2xl mx-auto">
        <div class="bg-white border rounded-lg p-8 space-y-4">
          <h2 class="text-2xl font-bold text-gray-800 mb-6">Shenzhen Qiyang Electronics Co., Ltd.</h2>
          <div class="space-y-3 text-gray-700">
            <p class="flex items-start gap-3">
              <span class="font-semibold min-w-[80px]">Address:</span>
              <span>2nd Floor, 23rd Building of Keyuan West, No.1 of Kezhi West Road, Yuehai street, Nanshan, Shenzhen, Guangdong, China</span>
            </p>
            <p class="flex items-start gap-3">
              <span class="font-semibold min-w-[80px]">Tel:</span>
              <span>+86 755-XXXX-XXXX</span>
            </p>
            <p class="flex items-start gap-3">
              <span class="font-semibold min-w-[80px]">Email:</span>
              <a href="mailto:sales@sz-qy.com.cn" class="text-primary hover:underline">sales@sz-qy.com.cn</a>
            </p>
            <p class="flex items-start gap-3">
              <span class="font-semibold min-w-[80px]">Website:</span>
              <a href="https://www.sz-qy.com.cn" class="text-primary hover:underline">www.sz-qy.com.cn</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
